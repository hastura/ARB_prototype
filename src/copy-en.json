  "detail.about.body": {
    "key": "detail.about.body",
    "role": "Body editorial",
    "text": "The Art of Reflecting is the true story that marks the first journey of Aksa, Rasa, and Bumi. Through loss and acceptance, they learn to recognize changes in how they live.\n\nAksa brings memories of events. Rasa raises questions about what those events mean. Bumi remembers the traces they leave in the body. The three do not always see the same thing in the same way.",
    "source": "C3 C4 C15",
    "status": "USULAN",
    "note": "Copy pengantar website, bukan sinopsis resmi atau kutipan naskah."
  },
