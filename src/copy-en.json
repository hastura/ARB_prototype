  "character.aksa.body": {
    "key": "character.aksa.body",
    "role": "Deskripsi karakter",
    "text": "Aksa lives through an experience before understanding what it means. Through memories and things left unresolved, he learns to be honest about what he feels.",
    "source": "C7",
    "status": "USULAN",
    "note": ""
  },
  "character.rasa.name": {
    "key": "character.rasa.name",
    "role": "Nama karakter",
    "text": "Rasa",
    "source": "C10",
    "status": "USULAN",
    "note": ""
  },
  "character.rasa.body": {
    "key": "character.rasa.body",
    "role": "Deskripsi karakter",
    "text": "Rasa listens before drawing conclusions, noticing the questions beneath a story and making room for answers that have yet to emerge.",
    "source": "C10",
    "status": "USULAN",
    "note": ""
  },
  "character.bumi.name": {
    "key": "character.bumi.name",
