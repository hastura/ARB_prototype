  "intro.body": {
    "key": "intro.body",
    "role": "Body",
    "text": "Aksa remembers what happened. Rasa listens for the questions beneath it. Bumi recognizes the traces it leaves in the body. As friends, they bring different perspectives and keep learning from the same experience.",
    "source": "C4",
    "status": "USULAN",
    "note": ""
  },
