  "intro.body": {
    "key": "intro.body",
    "role": "Body",
    "text": "Aksa mengingat apa yang terjadi. Rasa mendengarkan pertanyaan di baliknya. Bumi mengenali jejaknya pada tubuh. Mereka bersahabat, saling berbeda, dan terus belajar dari pengalaman yang sama.",
    "source": "C4",
    "status": "USULAN",
    "note": ""
  },
  "intro.question": {
    "key": "intro.question",
    "role": "Pertanyaan pemantik",
    "text": "Apa yang masih kamu pelajari dari pengalaman yang pernah kamu jalani?",
