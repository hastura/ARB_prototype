  "detail.about.body": {
    "key": "detail.about.body",
    "role": "Body editorial",
    "text": "The Art of Reflecting adalah kisah nyata yang menjadi perjalanan pertama Aksa, Rasa, dan Bumi. Melalui kehilangan dan penerimaan, mereka belajar mengenali apa yang berubah dalam cara mereka menjalani hidup.\n\nAksa membawa ingatan tentang peristiwa. Rasa membuka pertanyaan tentang maknanya. Bumi mengingat jejak yang tertinggal pada tubuh. Ketiganya tidak selalu melihat hal yang sama dengan cara yang sama.",
    "source": "C3 C4 C15",
    "status": "USULAN",
    "note": "Copy pengantar website, bukan sinopsis resmi atau kutipan naskah."
  },
