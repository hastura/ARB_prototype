  "character.aksa.name": {
    "key": "character.aksa.name",
    "role": "Nama karakter",
    "text": "Aksa",
    "source": "C7",
    "status": "USULAN",
    "note": ""
  },
  "character.aksa.body": {
    "key": "character.aksa.body",
    "role": "Deskripsi karakter",
    "text": "Aksa menjalani pengalaman sebelum memahami artinya. Lewat ingatan dan hal-hal yang belum selesai, ia belajar untuk jujur pada apa yang dirasakannya.",
    "source": "C7",
    "status": "USULAN",
    "note": ""
  },
  "character.rasa.name": {
    "key": "character.rasa.name",
    "role": "Nama karakter",
    "text": "Rasa",
    "source": "C10",
    "status": "USULAN",
    "note": ""
  },
  "character.rasa.body": {
    "key": "character.rasa.body",
    "role": "Deskripsi karakter",
    "text": "Rasa mendengarkan sebelum menyimpulkan. Ia memperhatikan pertanyaan di balik sebuah cerita dan memberi ruang bagi jawaban yang belum ditemukan.",
    "source": "C10",
    "status": "USULAN",
    "note": ""
  },
  "character.bumi.name": {
    "key": "character.bumi.name",
    "role": "Nama karakter",
    "text": "Bumi",
    "source": "C12",
    "status": "USULAN",
    "note": ""
  },
  "character.bumi.body": {
    "key": "character.bumi.body",
    "role": "Deskripsi karakter",
    "text": "Bumi mengenali jejak pengalaman pada tubuh. Ia membawa perhatian pada rasa lelah, batas, dan kebutuhan yang sering luput dari kata-kata.",
    "source": "C12",
    "status": "USULAN",
    "note": ""
  },
